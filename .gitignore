# ==========================================
# CaixaGo - Git Ignore
# ==========================================

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]

# Ambiente virtual
.venv/
venv/

# IDE
.vscode/
.idea/

# Credenciais e configurações privadas
.env
.env.*
!.env.example

# Banco de dados local
data/*.db

# Backups locais
backups/*.db

# Relatórios gerados
relatorios/*.pdf

# PyInstaller
build/
dist/

# Arquivos temporários
*.log
*.tmp
*.temp

# Sistema operacional
Thumbs.db
.DS_Store